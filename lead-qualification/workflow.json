    {
      "parameters": {
        "chatId": "YOUR_CHATID",
        "text": "=🚨 *NEW LEAD RECEIVED*\n\n🏷️ Priority: *{{ $json.output.Priority }}*\n⏱️ Urgency Score: *{{ $json.output.UrgencyScore }}/10*\n\n━━━━━━━━━━━━━━━━━━━\n👤 *CONTACT INFO*\n━━━━━━━━━━━━━━━━━━━\n*Name*     : {{ $json.Name }}\n*Email*    : {{ $json.email }}\n*Phone*    : {{ $json[\"Phone No\"] }}\n*Inquiry*  : {{ $json.Inquiry }}\n\n━━━━━━━━━━━━━━━━━━━\n🧠 *AI ASSESSMENT*\n━━━━━━━━━━━━━━━━━━━\n*Category* : {{ $json.output.Category }}\n*Intent*   : {{ $json.output.Intent }}\n*Budget*   : {{ $json.output.Budget }}\n*Urgency*  : {{ $json.output.Urgency }}\n*Score*    : {{ $json.output.UrgencyScore }}/10\n*Priority* : {{ $json.output.Priority }}\n\n━━━━━━━━━━━━━━━━━━━\n⏱️ *Action:* Follow up within 24 hours.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        624,
        -208
      ],
      "id": "8764f3c9-7050-471e-998d-e93ae5734c6c",
      "name": "Send_NewLeadToTeam"
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "=Subject: 🔔 New Lead —  {{ $json.output.Priority }}— {{ $json.Name }}",
        "emailType": "text",
        "message": "=Hi {{ $json.Name }},\n\nThank you for reaching out to us!\n\nWe've received your inquiry and our team is already reviewing it. Here's a quick confirmation of what you submitted:\n\n--------------------------------\nYour Inquiry\n--------------------------------\nName     : {{ $json.Name }}\nEmail    : {{ $json.email }}\nPhone    : {{ $json[\"Phone No\"] }}\nInquiry  : {{ $json.Inquiry }}\n--------------------------------\n\nWhat Happens Next?\nOur team will get back to you within 24 hours. If you'd like to add anything, just reply to this email.\n\nThank you for your interest — we look forward to helping you!\n\nWarm regards,\nYour Name\nYour Company",
        "options": {
          "appendAttribution": false
        }
      },
