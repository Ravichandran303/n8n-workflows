    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.Inquiry }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "=You are a lead qualification assistant. Analyze the following lead and return ONLY a valid JSON object with these exact keys: \"Category\", \"Intent\", \"Budget\", \"Urgency\", \"UrgencyScore\", \"Priority\".\n\nScoring Rules for UrgencyScore:\n- 9–10 : Extremely urgent — needs solution ASAP (within days)\n- 7–8  : High urgency — needs it within 1–2 weeks\n- 5–6  : Medium urgency — needs it within a month\n- 3–4  : Low urgency — planning for 1–3 months\n- 1–2  : Very low — just exploring, no timeline\n- 0    : No urgency mentioned\n\nPriority Rules (based on UrgencyScore):\n- UrgencyScore 8–10 → \"Hot Lead\"\n- UrgencyScore 5–7  → \"Warm Lead\"\n- UrgencyScore 0–4  → \"Cold Lead\"\n\nLead Data:\n- Name: {{ $json.Name }}\n- Email: {{ $json.email }}\n- Phone: {{ $json[\"Phone No\"] }}\n- Inquiry: {{ $json.Inquiry }}"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
